# ─── Core ────────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8100
WEB_BASE_URL=http://localhost:3001

# ─── Data ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://myth:myth@localhost:8101/mythbuster
REDIS_URL=redis://localhost:6379/7
MEDIA_DIR=./data/media
MEDIA_RETENTION_DAYS=7

# ─── Models ──────────────────────────────────────────────────────────────────
# DeepSeek V4 Flash: text reasoning workhorse (~$0.012/reel)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Groq: free Whisper transcription (2000 req/day, OpenAI-compatible)
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# Gemini: free video understanding + OCR (File API)
# The 2.5 family is refused for new API keys even though ListModels still shows
# it. If a model 404s with "no longer available to new users", pick a newer one.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.6-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite

# Optional: off-box forensics microservice (HF Space)
FORENSICS_URL=
FORENSICS_TOKEN=

# ─── Instagram ingest ────────────────────────────────────────────────────────
# For PERSONAL USE this is all you need — no Meta account, no app, no review.
# Downloading via yt-dlp is against Instagram's ToS, so it must not be the ingest
# path for anything public-facing. Point YTDLP_COOKIES_FILE at a Netscape-format
# cookie export from a BURNER Instagram account (never your own); most reels need
# a session, and an unauthenticated fetch returns an empty media response.
ENABLE_YTDLP_FALLBACK=true
# Must be a path INSIDE the container. data/ on the host is mounted at /data, so
# put the file there and use the path below. `./deploy/push-cookies.sh <file>`
# does all of this for you. Local dev: use a host path like ./data/cookies.txt.
YTDLP_COOKIES_FILE=/data/instagram-cookies.txt

# The sanctioned path, needed only for the public @mention bot (README §2).
# Leave blank and the ladder skips these rungs cleanly. All four are required
# together: the oEmbed probe resolves a bare /reel/ URL to a creator handle,
# which business_discovery then needs.
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me
META_GRAPH_VERSION=v23.0

# ─── Evidence ────────────────────────────────────────────────────────────────
GOOGLE_FACTCHECK_API_KEY=
SEARXNG_URL=http://localhost:8102
TAVILY_API_KEY=

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_MEDIA_MB=100
MAX_DURATION_SEC=600
WORKER_CONCURRENCY=2
